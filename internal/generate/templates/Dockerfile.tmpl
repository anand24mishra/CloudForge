# Generated by CloudForge. Review the command for your application before committing.
{{- if eq .Detection.Stack "node"}}
FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi
COPY . .
ENV NODE_ENV=production PORT={{.Detection.Port}}
EXPOSE {{.Detection.Port}}
CMD ["npm", "start"]
{{- else if eq .Detection.Stack "python"}}
FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT={{.Detection.Port}}
{{- if eq .Detection.DependencyFile "pyproject.toml"}}
COPY pyproject.toml ./
RUN pip install --no-cache-dir .
{{- else}}
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
{{- end}}
COPY . .
EXPOSE {{.Detection.Port}}
CMD ["python", "app.py"]
{{- else if eq .Detection.Stack "go"}}
FROM golang:1.26 AS build
WORKDIR /src
COPY . .
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/app ./...
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
EXPOSE {{.Detection.Port}}
USER nonroot:nonroot
ENTRYPOINT ["/app"]
{{- else if eq .Detection.Stack "java"}}
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN ./mvnw -B package -DskipTests || ./gradlew build -x test
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/target/*.jar /app/app.jar
EXPOSE {{.Detection.Port}}
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
{{- else}}
# Buildpacks fallback. The generated workflow uses pack when this file is not suitable.
FROM paketobuildpacks/builder-jammy-base
{{- end}}
