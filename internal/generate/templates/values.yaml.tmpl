nameOverride: {{.App.Name}}
fullnameOverride: {{.App.Name}}

image:
  repository: {{.App.ImageRepository}}
  tag: {{.App.ImageTag}}
  pullPolicy: IfNotPresent

service:
  type: ClusterIP
  port: {{.App.Port}}

containerPort: {{.App.ContainerPort}}
replicaCount: {{.App.Replicas}}

ingress:
  enabled: false
  className: traefik
  host: {{.App.Name}}.sslip.io
  tls: false

resources:
  requests:
    cpu: 25m
    memory: 64Mi
  limits:
    cpu: 250m
    memory: 256Mi

autoscaling:
  enabled: true
  minReplicas: 1
  maxReplicas: 3
  targetCPUUtilizationPercentage: 70

probes:
  path: /healthz
  initialDelaySeconds: 5
  periodSeconds: 10

env: []
imagePullSecrets: []
