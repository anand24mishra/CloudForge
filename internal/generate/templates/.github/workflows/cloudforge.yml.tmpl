name: CloudForge deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  packages: write
  security-events: write

env:
  IMAGE: ghcr.io/${{ "{{" }} github.repository_owner {{ "}}" }}/{{.App.Name}}
  DEPLOY_CONFIG_REPO: ${{ "{{" }} secrets.DEPLOY_CONFIG_REPO {{ "}}" }}

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Go
        if: ${{ "{{" }} hashFiles('go.mod') != '' {{ "}}" }}
        uses: actions/setup-go@v5
        with:
          go-version: stable
      - name: Set up Node
        if: ${{ "{{" }} hashFiles('package.json') != '' {{ "}}" }}
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - name: Test Go
        if: ${{ "{{" }} hashFiles('go.mod') != '' {{ "}}" }}
        run: go test ./...
      - name: Test Node
        if: ${{ "{{" }} hashFiles('package.json') != '' {{ "}}" }}
        run: npm ci && npm test --if-present
      - name: Test Python
        if: ${{ "{{" }} hashFiles('requirements.txt') != '' || hashFiles('pyproject.toml') != '' {{ "}}" }}
        run: python -m compileall .
  image:
    needs: verify
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      security-events: write
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-qemu-action@v3
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ "{{" }} github.actor {{ "}}" }}
          password: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}
      - uses: docker/metadata-action@v5
        id: meta
        with:
          images: ${{ "{{" }} env.IMAGE {{ "}}" }}
          tags: type=sha
      - name: Build with Dockerfile
        if: ${{ "{{" }} hashFiles('Dockerfile') != '' {{ "}}" }}
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ "{{" }} steps.meta.outputs.tags {{ "}}" }}
          labels: ${{ "{{" }} steps.meta.outputs.labels {{ "}}" }}
      - name: Build with Cloud Native Buildpacks
        if: ${{ "{{" }} hashFiles('Dockerfile') == '' {{ "}}" }}
        uses: docker/setup-buildx-action@v3
      - name: Install pack
        if: ${{ "{{" }} hashFiles('Dockerfile') == '' {{ "}}" }}
        uses: buildpacks/github-actions/setup-pack@v5.0.0
      - name: Pack build
        if: ${{ "{{" }} hashFiles('Dockerfile') == '' {{ "}}" }}
        run: pack build ${{ "{{" }} steps.meta.outputs.tags {{ "}}" }} --builder paketobuildpacks/builder-jammy-base --publish
      - name: Trivy scan
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: ${{ "{{" }} steps.meta.outputs.tags {{ "}}" }}
          format: sarif
          output: trivy-results.sarif
          exit-code: 1
          severity: CRITICAL,HIGH
      - uses: github/codeql-action/upload-sarif@v3
        if: always()
        with:
          sarif_file: trivy-results.sarif
      - name: Update deploy-config (opt-in)
        if: ${{ "{{" }} env.DEPLOY_CONFIG_REPO != '' {{ "}}" }}
        env:
          DEPLOY_CONFIG_TOKEN: ${{ "{{" }} secrets.DEPLOY_CONFIG_TOKEN {{ "}}" }}
        run: |
          # This is the only generated step that writes to a remote repository.
          # It stays disabled until the owner configures both secrets deliberately.
          test -n "$DEPLOY_CONFIG_TOKEN"
          git clone "https://x-access-token:${DEPLOY_CONFIG_TOKEN}@github.com/${DEPLOY_CONFIG_REPO}.git" deploy-config
          test -f "deploy-config/apps/{{.App.Name}}.yaml"
          sed -i.bak -E 's/^([[:space:]]*tag:).*/\1 '"${GITHUB_SHA}"'/' "deploy-config/apps/{{.App.Name}}.yaml"
          rm "deploy-config/apps/{{.App.Name}}.yaml.bak"
          git -C deploy-config config user.name cloudforge-bot
          git -C deploy-config config user.email cloudforge-bot@users.noreply.github.com
          git -C deploy-config add "apps/{{.App.Name}}.yaml"
          git -C deploy-config commit -m "deploy {{.App.Name}} ${GITHUB_SHA}" || exit 0
          git -C deploy-config push origin HEAD:main
